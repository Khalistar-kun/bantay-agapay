# Supabase Configuration
# Get these from https://supabase.com -> Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (KEEP PRIVATE!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Location Testing
# Set to false to use real geolocation, true for mock data
NEXT_PUBLIC_USE_MOCK_LOCATION=true

# School Coordinates (AFGBMTS - Caloocan, Philippines)
NEXT_PUBLIC_SCHOOL_LAT=14.2225
NEXT_PUBLIC_SCHOOL_LON=121.0115
NEXT_PUBLIC_GEOFENCE_RADIUS=500
