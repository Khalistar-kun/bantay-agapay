# Supabase Configuration
# Get these from https://supabase.com -> Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (KEEP PRIVATE!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Note: school location/geofence radius is configured by an admin at
# /admin/settings and stored in the system_settings table, not env vars.
# Create the first admin account locally with: node scripts/create-admin.js
